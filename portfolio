              <Hero darkMode={darkMode} setDarkMode={setDarkMode} />
              <Roots />
              <Blueprint />
              <Impact />
              <LifeOffline />
              <Footer />
            </div>
          );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
